# Copy to ~/charlie-voice/config.env and chmod 600. Never commit config.env.
# Fill in your own values. Placeholders below are not real credentials.

# Optional local echo stub (1 = reply locally without a webhook)
STUB_ECHO=0

# Wireless adb target for the Dot (host:port). Use a reserved LAN IP you control.
DOT_ADB=DOT_HOST:5555

# Agent listen port on the Dot (localhost only) and the matching adb-forward port on the Linux box
BRIDGE_PORT=8790
LOCAL_PORT=18790

# Local reply / control HTTP bind (keep on loopback)
REPLY_BIND=127.0.0.1
REPLY_PORT=8791
REPLY_TIMEOUT=120

# Playback level (0..1-ish). Raise if the Dot sounds too quiet.
PLAY_GAIN=0.35

# Optional local STT model name when using a non-realtime brain
WHISPER_MODEL=base.en

# Handoff to your AI chief-of-staff agent (placeholder URL/key — replace)
CHARLIE_WEBHOOK_URL=http://127.0.0.1:PORT/webhook
CHARLIE_WEBHOOK_KEY=changeme

# xAI realtime voice (create your own key in the xAI console; never commit it)
XAI_VOICE_API_KEY=changeme

# Optional overrides used by bridge.py
# BRAIN=realtime
# RT_URL=wss://api.x.ai/v1/realtime
# RT_MODEL=grok-voice-3.0
# RT_VOICE=rex
# RT_MAX_SECS=900
